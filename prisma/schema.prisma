// Ranmi — Base BD/CRM & Research Platform (generic, per-project entity/pipeline model)
// Every project defines its own EntityType/FieldDefinition schema and its own
// PipelineStage list — nothing here is hardcoded to any one industry.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────

enum ClassificationStatus {
  unclassified
  classified
  needs_review
}

enum ClassificationSource {
  engine
  manual_override
  engine_then_edited
}

enum SourceType {
  seed
  manual_add
  comparable
}

enum EmailStatus {
  verified
  inferred
  unknown
}

enum ActivityType {
  email_sent
  email_received
  call
  meeting
  note
  stage_change
}

enum UserStatus {
  active
  pending_invite
  deactivated
}

enum EmailProvider {
  gmail
  outlook
}

enum EmailConnectionStatus {
  connected
  needs_reauth
  disconnected
}

enum ThreadStatus {
  awaiting_reply
  replied
  no_response
}

enum MessageDirection {
  outbound
  inbound
}

enum MeetingStatus {
  scheduled
  completed
  canceled
}

enum TaskStatus {
  open
  done
}

enum TaskPriority {
  low
  medium
  high
}

// Separate from TaskStatus (open/done), which drives the automated pipeline
// pending-action lifecycle (pipeline-tasks.ts) and must keep its exact
// current semantics. TaskTrackerStatus is the user-facing progress state
// for manual task tracking — set independently, but completed/reopened
// here also flips TaskStatus + completedAt so the two stay in sync from
// the tracker's side.
enum TaskTrackerStatus {
  not_started
  in_progress
  under_review
  completed
  blocked
}

enum PopulateMode {
  similar_to_entity
  by_criteria
  database_wide
}

enum DataScope {
  all_entities
  owned_entities_only
}

enum TaxonomyKind {
  strategy
  focus_area
}

// The editable, DB-backed source of truth for the global default Strategies/
// Focus Areas taxonomy (Settings → Classification & Taxonomy). One row per
// kind. Projects normally define their own taxonomy (Project.taxonomy) —
// this global set is only a fallback/seed template for new projects.
model TaxonomySet {
  id        String       @id @default(uuid())
  kind      TaxonomyKind @unique
  data      Json
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("taxonomy_sets")
}

enum ProjectStatus {
  active
  on_hold
  completed
}

enum NotificationType {
  reply_received
  role_changed
  entities_reassigned
  email_needs_reauth
  meeting_reminder
  follow_up_due
}

// The kind of value a project-defined field holds. Drives both the input
// control rendered in the UI and how the AI research engine coerces/parses
// a found value before writing it into Entity.data.
enum FieldType {
  text
  long_text
  number
  currency
  date
  boolean
  single_select
  multi_select
  url
  email
  taxonomy_tag
}

// ────────────────────────────────────────────────────────────────────────
// Core: Roles & Users
// ────────────────────────────────────────────────────────────────────────

model Role {
  id               String    @id @default(uuid())
  name             String
  permissions      Json      @default("[]") // array of permission keys, Section 5.13
  dataScope        DataScope @default(all_entities) @map("data_scope")
  isSystemDefault  Boolean   @default(false) @map("is_system_default")
  createdAt        DateTime  @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  name            String
  passwordHash    String?    @map("password_hash")
  roleId          String     @map("role_id")
  role            Role       @relation(fields: [roleId], references: [id])
  isAccountOwner  Boolean    @default(false) @map("is_account_owner")
  status          UserStatus @default(pending_invite)
  invitedById     String?    @map("invited_by")
  invitedBy       User?      @relation("Invites", fields: [invitedById], references: [id])
  invitedUsers    User[]     @relation("Invites")
  invitedAt       DateTime?  @map("invited_at")
  joinedAt        DateTime?  @map("joined_at")
  passwordResetToken     String?   @unique @map("password_reset_token")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  emailConnection    EmailConnection?
  ownedEntityStages  EntityStage[]     @relation("StageOwner")
  ownedEntities      Entity[]          @relation("EntityOwner")
  ownedTasks         Task[]            @relation("TaskOwner")
  verifiedTasks      Task[]            @relation("TaskCompletionVerifiedBy")
  taskComments       TaskComment[]     @relation("TaskCommentCreatedBy")
  activityLogs       ActivityLog[]     @relation("ActivityCreatedBy")
  notifications      Notification[]
  populateRuns       PopulateRun[]
  deletedEntities    Entity[]          @relation("EntityDeletedBy")
  ownedProjects      Project[]         @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  messageDrafts      MessageDraft[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ────────────────────────────────────────────────────────────────────────
// Projects — the schema boundary. Every project defines its own EntityType
// (what the tracked thing is called and what fields it has), its own
// PipelineStage list, and its own taxonomy. Nothing about "what a project
// tracks" is hardcoded anywhere else in the platform.
// ────────────────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?       @db.Text
  type        String?
  status      ProjectStatus @default(active)
  startDate   DateTime      @map("start_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  ownerId     String        @map("owner_id")
  owner       User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  /// AI-generated, project-specific classification structure — shape
  /// { "Parent": ["Child", ...] }. Null until generated + confirmed.
  taxonomy            Json?     @map("taxonomy")
  taxonomyDescription String?   @map("taxonomy_description") @db.Text
  taxonomyConfirmedAt DateTime? @map("taxonomy_confirmed_at")

  /// Free-text steer for the AI research engine (replaces the old hardcoded
  /// "institutional investment manager" prompt prose) — e.g. "focus on
  /// institutional-grade sources only" or "prioritize recent conference
  /// speakers." Optional; research still works from field researchHints
  /// alone if unset.
  researchFocus String? @map("research_focus") @db.Text

  /// Priority keyword list used to re-rank discovered contacts (replaces
  /// the old hardcoded "Capital Markets/Introductions/Formation" title
  /// bias) — e.g. ["Head of Talent", "Recruiting"]. Empty = no re-ranking.
  contactPriorityTitles String[] @default([]) @map("contact_priority_titles")

  members            ProjectMember[]
  tasks              Task[]
  entityTypes        EntityType[]
  entities           Entity[]
  pipelineStages     PipelineStage[]
  qualificationRules QualificationRule[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  addedAt   DateTime @default(now()) @map("added_at")

  @@unique([projectId, userId])
  @@map("project_members")
}

// One or more per project (usually one) — defines what "the tracked thing"
// is called (e.g. "Firm", "Candidate", "Speaker") and, via FieldDefinition,
// exactly what fields it has. Nothing outside this model + FieldDefinition
// determines an entity's shape.
model EntityType {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id])
  name       String   // singular display label, e.g. "Firm"
  pluralName String   @map("plural_name") // e.g. "Firms"
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  fields   FieldDefinition[]
  entities Entity[]

  @@unique([projectId, name])
  @@map("entity_types")
}

model FieldDefinition {
  id           String     @id @default(uuid())
  entityTypeId String     @map("entity_type_id")
  entityType   EntityType @relation(fields: [entityTypeId], references: [id])
  key          String     // stable key into Entity.data, e.g. "aum_value"
  label        String     // display label, e.g. "AUM"
  type         FieldType
  options      Json?      // string[] of choices, for single_select/multi_select
  required     Boolean    @default(false)

  /// If true, the AI research engine will attempt to find/fill this field.
  aiResearchable Boolean @default(false) @map("ai_researchable")
  /// Natural-language hint fed to the research prompt for this field, e.g.
  /// "the firm's assets under management, in USD."
  researchHint   String? @map("research_hint") @db.Text

  /// If true, this field's value contributes to the Populate/"Find Similar"
  /// similarity score.
  includeInSimilarity Boolean @default(false) @map("include_in_similarity")

  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([entityTypeId, key])
  @@map("field_definitions")
}

// A numeric-range qualification gate against one project-defined field —
// generalizes the old hardcoded AUM-min/AUM-max MandateSettings singleton.
model QualificationRule {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  fieldKey  String   @map("field_key")
  label     String?
  min       Decimal? @db.Decimal(20, 2)
  max       Decimal? @db.Decimal(20, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("qualification_rules")
}

// The generic replacement for the old fixed `Firm` model. Field values live
// in `data`, keyed by the owning EntityType's FieldDefinition.key — same
// pattern the old Firm.strategies/focusAreas JSON blobs already used, just
// generalized to every field instead of two.
model Entity {
  id           String     @id @default(uuid())
  projectId    String     @map("project_id")
  project      Project    @relation(fields: [projectId], references: [id])
  entityTypeId String     @map("entity_type_id")
  entityType   EntityType @relation(fields: [entityTypeId], references: [id])
  name         String
  ownerId      String?    @map("owner_id")
  owner        User?      @relation("EntityOwner", fields: [ownerId], references: [id])
  data         Json       @default("{}")

  classificationStatus ClassificationStatus  @default(unclassified) @map("classification_status")
  classificationSource ClassificationSource? @map("classification_source")
  classifiedAt         DateTime?             @map("classified_at")

  sourceType    SourceType   @default(manual_add) @map("source_type")
  similarTo     String[]     @default([]) @map("similar_to")
  populateRunId String?      @map("populate_run_id")
  populateRun   PopulateRun? @relation(fields: [populateRunId], references: [id])

  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by")
  deletedBy   User?     @relation("EntityDeletedBy", fields: [deletedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contacts        Contact[]
  stage           EntityStage?
  activityLog     ActivityLog[]
  emailThreads    EmailThread[]
  meetings        Meeting[]
  tasks           Task[]
  comparablesFrom PopulateRun[] @relation("SeedEntity")

  @@map("entities")
}

model Contact {
  id                 String      @id @default(uuid())
  entityId           String      @map("entity_id")
  entity             Entity      @relation(fields: [entityId], references: [id])
  name               String
  title              String?
  email              String?
  emailStatus        EmailStatus @default(unknown) @map("email_status")
  emailSource        String?     @map("email_source")
  alternateEmails    String[]    @default([]) @map("alternate_emails")
  linkedinUrl        String?     @map("linkedin_url")
  rank               Int         @default(1)
  isPrimaryBdContact Boolean     @default(false) @map("is_primary_bd_contact")
  removedAt          DateTime?   @map("removed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activityLog  ActivityLog[]
  emailThreads EmailThread[]
  meetings     Meeting[]
  tasks        Task[]

  @@map("contacts")
}

// Ordered, per-project pipeline stage. Replaces the fixed CrmStage enum.
// positiveNextStageId/negativeNextStageId are plain id references (no FK
// constraint, same "flexible reference" pattern ResearchSource already
// uses) so a stage can point forward without Prisma's self-relation
// ceremony — validated at the application layer instead.
model PipelineStage {
  id    String @id @default(uuid())
  projectId String @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])
  key   String
  label String
  color String @default("#6b7280")
  order Int

  /// If set, entering this stage auto-creates a pending task with this
  /// title (idempotent — only if no open task with this title exists yet).
  autoTaskTitle String? @map("auto_task_title")
  /// If set, entering this stage auto-creates this checklist of tasks
  /// (idempotent by title, same as autoTaskTitle).
  autoChecklist String[] @default([]) @map("auto_checklist")
  /// If true, this stage is a one-way terminal state — once entered, the
  /// entity can't be moved to another stage (generalizes Do-Not-Contact).
  isTerminal Boolean @default(false) @map("is_terminal")
  /// "Log outcome" action targets — a stage can optionally define where a
  /// positive/negative outcome moves the entity to next.
  positiveNextStageId String? @map("positive_next_stage_id")
  negativeNextStageId String? @map("negative_next_stage_id")

  createdAt DateTime @default(now()) @map("created_at")

  entityStages EntityStage[]

  @@unique([projectId, key])
  @@map("pipeline_stages")
}

// Replaces CrmStageRow — an entity's current position in its project's
// pipeline.
model EntityStage {
  id               String        @id @default(uuid())
  entityId         String        @unique @map("entity_id")
  entity           Entity        @relation(fields: [entityId], references: [id])
  stageId          String        @map("stage_id")
  stage            PipelineStage @relation(fields: [stageId], references: [id])
  stageChangedAt   DateTime      @default(now()) @map("stage_changed_at")
  ownerId          String?       @map("owner")
  owner            User?         @relation("StageOwner", fields: [ownerId], references: [id])
  nextFollowUpDate DateTime?     @map("next_follow_up_date") @db.Date
  dealNotes        String?       @map("deal_notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("entity_stages")
}

model ActivityLog {
  id        String       @id @default(uuid())
  entityId  String       @map("entity_id")
  entity    Entity       @relation(fields: [entityId], references: [id])
  contactId String?      @map("contact_id")
  contact   Contact?     @relation(fields: [contactId], references: [id])
  type      ActivityType
  body      String       @db.Text
  createdAt DateTime     @default(now()) @map("created_at")
  createdById String?    @map("created_by")
  createdBy   User?      @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  deletable Boolean      @default(false) // true only for manually-added note/call entries

  @@map("activity_log")
}

// entity_id is polymorphic — it references either entities.id (entity_type
// "entity") or contacts.id (entity_type "contact") depending on entity_type,
// so it deliberately carries no foreign key constraint of its own.
model ResearchSource {
  id                     String   @id @default(uuid())
  entityType             String   @map("entity_type") // "entity" | "contact"
  entityId               String   @map("entity_id")
  fieldName              String   @map("field_name")
  sourceUrlOrDescription String   @map("source_url_or_description") @db.Text
  retrievedAt            DateTime @default(now()) @map("retrieved_at")

  @@map("research_sources")
  @@index([entityType, entityId])
}

model AppSettings {
  id                    Int    @id @default(1)
  hunterApiKeyEncrypted String? @map("hunter_api_key_encrypted")
  followUpThresholdDays Int    @default(7) @map("follow_up_threshold_days")

  @@map("app_settings")
}

// ────────────────────────────────────────────────────────────────────────
// Email / Calendar
// ────────────────────────────────────────────────────────────────────────

model EmailConnection {
  id             String                 @id @default(uuid())
  userId         String                 @unique @map("user_id")
  user           User                   @relation(fields: [userId], references: [id])
  provider       EmailProvider
  oauthTokenRef  String                 @map("oauth_token_ref") // encrypted access+refresh token blob
  connectedEmail String                 @map("connected_email")
  status         EmailConnectionStatus  @default(connected)
  watchExpiresAt DateTime?              @map("watch_expires_at")
  connectedAt    DateTime               @default(now()) @map("connected_at")

  @@map("email_connections")
}

model EmailThread {
  id                   String       @id @default(uuid())
  entityId             String?      @map("entity_id")
  entity               Entity?      @relation(fields: [entityId], references: [id])
  contactId            String?      @map("contact_id")
  contact              Contact?     @relation(fields: [contactId], references: [id])
  adHocRecipientName   String?      @map("ad_hoc_recipient_name")
  adHocRecipientEmail  String?      @map("ad_hoc_recipient_email")
  subject              String
  providerThreadId     String?      @map("provider_thread_id")
  status               ThreadStatus @default(awaiting_reply)
  isFreeForm           Boolean      @default(false) @map("is_free_form")
  hasUnreadReply       Boolean      @default(false) @map("has_unread_reply")
  followUpSentAt       DateTime?    @map("follow_up_sent_at")
  deletedAt            DateTime?    @map("deleted_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  lastActivityAt       DateTime     @default(now()) @map("last_activity_at")

  messages EmailMessage[]

  @@map("email_threads")
}

model EmailMessage {
  id                String            @id @default(uuid())
  threadId          String            @map("thread_id")
  thread            EmailThread       @relation(fields: [threadId], references: [id])
  direction         MessageDirection
  body              String            @db.Text
  isFollowUp        Boolean           @default(false) @map("is_follow_up")
  providerMessageId String?           @map("provider_message_id")
  ccEmails          String[]          @default([]) @map("cc_emails")
  bccEmails         String[]          @default([]) @map("bcc_emails")
  attachments       Json?
  sentAt            DateTime          @default(now()) @map("sent_at")

  @@index([threadId, providerMessageId])
  @@map("email_messages")
}

// Messages module — Drafts folder. Saved but not yet sent; sending a draft
// creates the real EmailThread/EmailMessage via the same send pipeline as
// everything else, then removes the draft row.
model MessageDraft {
  id              String   @id @default(uuid())
  createdById     String   @map("created_by_id")
  createdBy       User     @relation(fields: [createdById], references: [id])
  entityId        String?  @map("entity_id")
  contactId       String?  @map("contact_id")
  replyToThreadId String?  @map("reply_to_thread_id")
  toName          String?  @map("to_name")
  toEmail         String?  @map("to_email")
  ccEmails        String[] @default([]) @map("cc_emails")
  bccEmails       String[] @default([]) @map("bcc_emails")
  subject         String   @default("")
  body            String   @default("") @db.Text
  attachments     Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("message_drafts")
}

model Meeting {
  id                  String        @id @default(uuid())
  entityId            String        @map("entity_id")
  entity              Entity        @relation(fields: [entityId], references: [id])
  contactId           String?       @map("contact_id")
  contact             Contact?      @relation(fields: [contactId], references: [id])
  adHocRecipientName  String?       @map("ad_hoc_recipient_name")
  adHocRecipientEmail String?       @map("ad_hoc_recipient_email")
  title               String
  startTime           DateTime      @map("start_time")
  endTime             DateTime      @map("end_time")
  locationOrLink      String?       @map("location_or_link")
  agendaNotes         String?       @map("agenda_notes") @db.Text
  providerEventId     String?       @map("provider_event_id")
  status              MeetingStatus @default(scheduled)
  notesLoggedAt        DateTime?    @map("notes_logged_at")
  createdAt           DateTime      @default(now()) @map("created_at")

  @@map("meetings")
}

model Task {
  id             String       @id @default(uuid())
  entityId       String       @map("entity_id")
  entity         Entity       @relation(fields: [entityId], references: [id])
  contactId      String?      @map("contact_id")
  contact        Contact?     @relation(fields: [contactId], references: [id])
  projectId      String?      @map("project_id")
  project        Project?     @relation(fields: [projectId], references: [id])
  title          String
  description    String?      @db.Text
  priority       TaskPriority @default(medium)
  dueDate        DateTime?    @map("due_date") @db.Date
  status         TaskStatus   @default(open)
  isFromTemplate Boolean      @default(false) @map("is_from_template")
  ownerId        String?      @map("owner")
  owner          User?        @relation("TaskOwner", fields: [ownerId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")
  completedAt    DateTime?    @map("completed_at")
  /// Groups the per-entity task rows created together from one multi-entity
  /// "Add Task" submission, so the Project → Actions tab can offer a single
  /// "Send Email" button that executes across the whole batch at once.
  batchId        String?      @map("batch_id")

  trackerStatus         TaskTrackerStatus @default(not_started) @map("tracker_status")
  progressPercent        Int              @default(0) @map("progress_percent")
  timeSpentMinutes       Int              @default(0) @map("time_spent_minutes")
  completionVerifiedById String?          @map("completion_verified_by")
  completionVerifiedBy   User?            @relation("TaskCompletionVerifiedBy", fields: [completionVerifiedById], references: [id])
  completionVerifiedAt   DateTime?        @map("completion_verified_at")
  comments               TaskComment[]

  @@index([batchId])
  @@map("tasks")
}

// Combined activity feed for a task: system-generated entries (status
// changes, progress updates, time logged) and user-written comments live in
// the same ordered stream, distinguished by isSystem — one feed to render
// instead of merging two separate queries client-side.
model TaskComment {
  id          String   @id @default(uuid())
  taskId      String   @map("task_id")
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  body        String   @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdById String?  @map("created_by")
  createdBy   User?    @relation("TaskCommentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("task_comments")
}

model PopulateRun {
  id                     String       @id @default(uuid())
  mode                   PopulateMode
  seedEntityId           String?      @map("seed_entity_id")
  seedEntity             Entity?      @relation("SeedEntity", fields: [seedEntityId], references: [id])
  criteria               Json?
  triggeredById          String       @map("triggered_by")
  triggeredBy            User         @relation(fields: [triggeredById], references: [id])
  triggeredAt            DateTime     @default(now()) @map("triggered_at")
  entitiesFound            Int        @default(0) @map("entities_found")
  entitiesAdded            Int        @default(0) @map("entities_added")
  entitiesSkippedDuplicate Int        @default(0) @map("entities_skipped_duplicate")

  entitiesProduced Entity[]

  @@map("populate_runs")
}

model Notification {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  user            User             @relation(fields: [userId], references: [id])
  type            NotificationType
  relatedEntityId String?          @map("related_entity_id")
  body            String
  isRead          Boolean          @default(false) @map("is_read")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}
